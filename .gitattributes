# Force shell scripts to always use LF line endings,
# even on Windows, to ensure compatibility with macOS/Linux.
*.sh text eol=lf

# Force Windows batch scripts to always use CRLF line endings,
# to prevent cmd.exe command parsing truncation and EOF issues.
*.bat text eol=crlf
*.cmd text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
